{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GavinDu/daily-news-data-1/blob/main/schemas/news-event.schema.json",
  "title": "Market News Dataset",
  "type": "object",
  "required": [
    "metadata",
    "events"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "producer",
        "generated_at",
        "collection_window_start",
        "collection_window_end",
        "status",
        "target_event_count",
        "validated_event_count",
        "unique_dedup_keys",
        "source_status",
        "validation",
        "limitations"
      ],
      "properties": {
        "producer": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "collection_window_start": {
          "type": "string",
          "format": "date-time"
        },
        "collection_window_end": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string"
        },
        "target_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "validated_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "unique_dedup_keys": {
          "type": "integer",
          "minimum": 0
        },
        "source_status": {
          "type": "object"
        },
        "validation": {
          "type": "object"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NewsEvent"
      }
    }
  },
  "$defs": {
    "NewsEvent": {
      "type": "object",
      "required": [
        "id",
        "published_at",
        "source",
        "url",
        "headline",
        "summary",
        "entities",
        "event_type",
        "sentiment",
        "severity",
        "reliability",
        "fetched_at",
        "dedup_key"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "event_type": {
          "enum": [
            "macro",
            "policy",
            "geopolitical",
            "energy",
            "earnings",
            "credit",
            "market_structure",
            "tech"
          ]
        },
        "sentiment": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "severity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reliability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "dedup_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
